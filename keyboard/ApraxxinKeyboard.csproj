<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ships with every Windows 10/11 PC, so the app runs
       anywhere without installing a runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ApraxxinKeyboard</AssemblyName>
    <RootNamespace>ApraxxinKeyboard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Apraxxin Keyboard</Product>
    <Description>Type in the Apraxxin script anywhere in Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\build\Apraxxin.ttf" LogicalName="Apraxxin.ttf" />
  </ItemGroup>
</Project>
